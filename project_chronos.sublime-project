{
	"folders":
	[
		{
			"path": "."
		}
	],
	"build_systems":
	[
		{
			"name": "Debug",
			"working_dir": "$project_path",
			"cmd": [
				"odin",
				"run",
				"src",
				"-show-timings",
				"-strict-style",
				"-vet-unused",
				"-vet-style",
				"-vet-semicolon",
				"-debug",
			],
			"file_regex": "^(.+)\\(([0-9]+):([0-9]+)\\) (.+)$",
			"variants": [
				{
					"name": "Build",
					"cmd": [
						"$project_path\\build.bat",
						"debug"
					]
				},
				{
					"name": "Run",
					"cmd": [
						"$project_path\\run.bat",
						"debug"
					]
				}
			]
		},
		{
			"name": "Release",
			"working_dir": "$project_path",
			"file_regex": "^(.+)\\(([0-9]+):([0-9]+)\\) (.+)$",
			"variants": [
				{
					"name": "Build",
					"cmd": [
						"$project_path\\build.bat",
						"release"
					]
				},
				{
					"name": "Run",
					"cmd": [
						"$project_path\\run.bat",
						"release"
					]
				}
			]
		}
	],
	"settings":
	{
		"auto_complete": true,
		"LSP":
		{
			"odin":
			{
				"enabled": true
			}
		}
	}
}
